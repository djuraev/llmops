# Copy to .env and paste your key. Without a key the lab runs on an offline mock model.
OPENAI_API_KEY=sk-...
# Model names change over time: check https://platform.openai.com/docs/models
CHAT_MODEL=gpt-4o-mini
JUDGE_MODEL=gpt-4o-mini
EMBED_MODEL=text-embedding-3-small
SMALL_MODEL=gpt-4o-mini
LARGE_MODEL=gpt-4o
